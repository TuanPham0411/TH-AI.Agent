[Unit]
Description=TH AI API
After=network.target postgresql.service

[Service]
Type=simple
User=thai
Group=thai
WorkingDirectory=/opt/th-ai/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=128
EnvironmentFile=/etc/th-ai/runtime.env
ExecStart=/opt/th-ai/current/runtime/bin/node server/index.js
Restart=on-failure
RestartSec=5
MemoryMax=224M
CPUQuota=50%
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/th-ai
UMask=0077

[Install]
WantedBy=multi-user.target
