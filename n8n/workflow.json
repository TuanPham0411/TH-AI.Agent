    {
      "id": "e23b0133-fcb7-5573-a8d8-ec0662fdcb70",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        0
      ],
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "Bạn là trợ lý điều phối của TH AI.Agent. Trả lời bằng ngôn ngữ người dùng. Giao nghiên cứu cho Research Agent và thao tác bảng tính cho Sheet Agent. Chỉ ghi Google Sheets khi người dùng yêu cầu rõ ràng. Không tự gửi email, đăng bài hoặc kích hoạt workflow. Không khẳng định đã dùng công cụ nếu chưa có kết quả. Hỏi lại khi thiếu bảng tính hoặc trường dữ liệu.",
          "maxIterations": 5
        }
      }
    },
    {
      "id": "08073199-b9a3-5ddb-8471-dc6476a248ac",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        170,
        230
      ],
      "parameters": {
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "id": "1641c74b-e30a-54ec-97a5-9507171a4744",
      "name": "Google Gemini Research Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
