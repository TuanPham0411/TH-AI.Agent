{
  "name": "th-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server/index.js",
    "build": "vite build && node server/build.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node server/migrate.js",
    "test:integration": "node --test tests/database.test.js",
    "test:browser": "node tests/editor.browser.mjs && node tests/workbench.browser.mjs && node tests/company.browser.mjs && node tests/office.browser.mjs && node tests/director-meeting.browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.22.0",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "oracledb": "^6.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.65.0",
    "vite": "^6.4.1"
  }
}
